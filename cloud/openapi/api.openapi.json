  "components": {
    "schemas": {
      "AgentAction": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete"
            ],
            "title": "Type"
          },
          "id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "draft_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draft Id"
          },
          "event": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event"
          },
          "updates": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updates"
          },
          "scope": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "future",
                  "all",
                  "past",
                  "single"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Scope"
          },
          "effective_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective Date"
          },
          "choice_group_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Choice Group Id"
          },
          "option_label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Option Label"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "AgentAction"
      },
      "AgentActionReceipt": {
        "properties": {
          "plan_id": {
            "type": "string",
            "format": "uuid",
            "title": "Plan Id"
          },
          "draft_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Draft Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "rejected",
              "failed"
            ],
            "title": "Status"
          },
          "event_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          }
        },
        "type": "object",
        "required": [
          "plan_id",
          "draft_id",
          "status"
        ],
        "title": "AgentActionReceipt"
      },
      "AgentBudget": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "remaining_usd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remaining Usd"
          }
        },
        "type": "object",
        "title": "AgentBudget"
      },
      "AgentPlanRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 2000,
            "title": "Message",
            "default": ""
          },
          "date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "snapshot": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array",
                "maxItems": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot"
          },
          "receipts": {
            "items": {
              "$ref": "#/components/schemas/AgentActionReceipt"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Receipts"
          },
          "continue_planning": {
            "type": "boolean",
            "title": "Continue Planning",
            "default": false
          }
        },
        "type": "object",
        "title": "AgentPlanRequest"
      },
      "AgentPlanResponse": {
        "properties": {
          "plan_id": {
            "type": "string",
            "format": "uuid",
            "title": "Plan Id"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "actions": {
            "items": {
              "$ref": "#/components/schemas/AgentAction"
            },
            "type": "array",
            "title": "Actions",
            "default": []
          },
          "configured": {
            "type": "boolean",
            "title": "Configured",
            "default": true
          },
          "usage": {
            "$ref": "#/components/schemas/AgentUsage"
          },
          "budget": {
            "$ref": "#/components/schemas/AgentBudget"
          }
        },
        "type": "object",
        "required": [
          "plan_id",
          "message",
          "usage",
          "budget"
        ],
        "title": "AgentPlanResponse"
      },
      "AgentUsage": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model"
          },
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens",
            "default": 0
          },
          "completion_tokens": {
            "type": "integer",
            "title": "Completion Tokens",
            "default": 0
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "model"
        ],
        "title": "AgentUsage"
      },
      "CloudEvent": {
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid",
            "title": "Eventid"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "operationId": {
            "type": "string",
            "format": "uuid",
            "title": "Operationid"
          },
          "seq": {
            "type": "integer",
            "title": "Seq"
          },
          "deleted": {
            "type": "boolean",
            "title": "Deleted",
            "default": false
          },
          "trashUntil": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trashuntil"
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "eventId",
          "version",
          "operationId",
          "seq"
        ],
        "title": "CloudEvent"
      },
      "DeviceInfo": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "current": {
            "type": "boolean",
            "title": "Current",
            "default": false
          },
          "last_active_at": {
            "type": "string",
            "format": "date-time",
            "title": "Last Active At"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
