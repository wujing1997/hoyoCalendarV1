{
  "name": "hoyocalendar",
  "version": "3.0.12",
  "description": "面向效率工作的本地优先桌面日程与任务管理工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:backend": "python -m PyInstaller --noconfirm backend_server.spec",
    "build:electron": "electron-builder --win",
    "build": "npm run build:backend && npm run build:electron",
    "test:core": "node --test tests/*.test.js",
    "test:backend": "python -m unittest discover -s backend/tests -p \"test_*.py\"",
    "test:cloud": "cd cloud && python -m pytest tests -q",
    "test": "npm run test:core && npm run test:backend"
  },
  "keywords": [
    "electron",
    "calendar",
    "productivity",
    "deadline"
  ],
  "author": "HoyoCalendar Team",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.hoyocalendar.app",
    "productName": "HoYoCalendar",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/backend_server",
        "to": "backend_server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "HoYoCalendarV3.0.12-setup.exe",
      "include": "installer/installer.nsh",
      "shortcutName": "HoYoCalendar"
    }
  },
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "lucide": "^1.37.0",
    "lunar-javascript": "^1.6.12"
  }
}
